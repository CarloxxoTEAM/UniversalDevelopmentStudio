{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniversalDevelopmentStudio",
  "version": "1.4.1",
  "identifier": "org.uds.universaldevelopmentstudio",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Universal Development Studio", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": false,
    "copyright": "© 2026 Universal Development Studio contributors. MIT.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
